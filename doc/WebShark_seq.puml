@startuml
autonumber

actor User
participant "Vue.js" as Web
participant "Laravel" as Controller
participant "Valkey" as Queue
participant "Queue Worker" as Job
participant "analyze.py" as Python
participant "Tshark" as Tshark
database PostgreSQL as DB

== File Upload and Job Dispatch ==
User -> Web: Upload .pcap file
activate User
activate Web
Web -> Controller: POST /file/uploadPcap
activate Controller
Controller -> Controller: Save file
Controller -> Queue: Dispatch background job
Controller -> DB: Insert analysis_job\n(status: dispatching)
Controller --> Web: Redirect response
deactivate Controller
Web --> User: Show Progress Bar
deactivate Web

== Background Processing ==
Job -> Queue: Poll for next job
activate Job
Queue --> Job: Return job data
Job -> DB: Update analysis_job\n(status: analyzing)
Job -> Python: Run analyze.py
activate Python

opt file is valid PCAP
    Python -> Tshark: Analyze layers
    activate Tshark
    Tshark --> Python: Return data
    deactivate Tshark
    
    loop for each packet chunk
        Python -> Python: Parse data
        Python -> DB: Update progress
        Python -> DB: Batch insert packets (L3/L4/L7)
    end
end

Python --> Job: Exit (success/fail)
deactivate Python
Job -> DB: Update analysis_job\n(status: finished / failed)
Job -> Job: Remove file
deactivate Job

== Result Viewing ==
User -> Web: View Analysis page
activate Web
Web -> Controller: GET /pcap/analysis/{id}
activate Controller
Controller -> DB: Query analysis_job + packets
activate DB
DB --> Controller: Return data
deactivate DB
Controller --> Web: Return data
deactivate Controller
Web --> User: Render results
deactivate Web
deactivate User

@enduml
