@startuml
autonumber
skinparam ParticipantPadding 10
skinparam BoxPadding 10

actor User
participant "Vue.js" as Web
participant "Laravel" as Controller
participant "Valkey" as Queue
participant "Queue Worker" as Job
participant "analyze.py" as Python
database PostgreSQL as DB

== File Upload and Job Dispatch ==
User -> Web: Upload .pcap file
activate User
activate Web
Web -> Controller: POST /file/uploadPcap
activate Controller
Controller -> Controller: Save file
Controller -> Queue: Dispatch background job
Controller -> DB: Insert analysis_job\n(status: dispatching, L7_status: dispatching)
Controller --> Web: Redirect response
deactivate Controller
Web --> User: Show Progress Bar
deactivate Web

== Background Processing ==
Job -> Queue: Poll for next job
activate Job
Queue --> Job: Return job data
Job -> Python: Run analyze.py
activate Python

opt file is valid PCAP
        Python -> DB: Update progress_percentage
        Python -> DB: Batch insert packets (L3/L4)
end

opt Scapy analysis passed
        Python -> DB: Stream update L7_attributes (batch)
end

Python --> Job: Exit (success/fail)
deactivate Python
Job -> DB: Update analysis_job\n(status: finished / failed,\nL7_status: finished / failed)
Job -> Job: Remove file
deactivate Job

== Result Viewing ==
User -> Web: View Analysis page
activate Web
Web -> Controller: GET /pcap/analysis/{id}
activate Controller
Controller -> DB: Query analysis_job + packets
activate DB
DB --> Controller: Return data
deactivate DB
Controller --> Web: Return data\n(status, L7_status, packets)
deactivate Controller
Web --> User: Render results\n(L7 shown only if L7_status: finished)
deactivate Web
deactivate User

@enduml
