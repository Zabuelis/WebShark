@startuml
autonumber
skinparam ParticipantPadding 10
skinparam BoxPadding 10

actor User
participant "Vue.js" as Web
participant "Laravel" as Controller
participant "Valkey" as Queue
participant "Queue Worker" as Job
participant "analyze.py" as Python
database PostgreSQL as DB

== File Upload and Job Dispatch ==
User -> Web: Upload .pcap file
activate User
activate Web
Web -> Controller: POST /file/uploadPcap
activate Controller
Controller -> Controller: Save file
Controller -> Queue: Dispatch background job
Controller -> DB: Insert analysis_job\n(status: dispatching, L7_status: dispatching)
Controller --> Web: Redirect response
deactivate Controller
Web --> User: Show Progress Bar
deactivate Web

@enduml
