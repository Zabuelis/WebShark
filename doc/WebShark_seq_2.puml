@startuml
autonumber
skinparam ParticipantPadding 10
skinparam BoxPadding 10

actor User
participant "Vue.js" as Web
participant "Laravel" as Controller
participant "Valkey" as Queue
participant "Queue Worker" as Job
participant "analyze.py" as Python
participant "Scapy" as Scapy
participant "tshark" as Tshark
database PostgreSQL as DB

== Background Processing ==
Job -> Queue: Poll for next job
activate Job
Queue --> Job: Return job data
Job -> Python: Run analyze.py
activate Python

opt file is valid PCAP
    Python -> Scapy: Analyze L3/L4
    activate Scapy
    Scapy -> DB: Update progress_percentage
    Scapy -> DB: Batch insert packets (L3/L4)
    Scapy --> Python: Exit (success/fail)
    deactivate Scapy

    opt Scapy analysis passed
        Python -> Tshark: Analyze L7
        activate Tshark
        Tshark -> DB: Stream update L7_attributes (batch)
        Tshark --> Python: Exit (success/fail)
        deactivate Tshark
    end
end

Python --> Job: Exit (success/fail)
deactivate Python
Job -> DB: Update analysis_job\n(status: finished / failed,\nL7_status: finished / failed)
Job -> Job: Remove file
deactivate Job

@enduml
