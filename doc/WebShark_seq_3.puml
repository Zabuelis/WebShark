@startuml
autonumber

actor User
participant "Vue.js" as Web
participant "Laravel" as Controller
participant "Valkey" as Queue
participant "Queue Worker" as Job
participant "analyze.py" as Python
participant "Tshark" as Tshark
database PostgreSQL as DB

== Result Viewing ==
User -> Web: View Analysis page
activate Web
Web -> Controller: GET /pcap/analysis/{id}
activate Controller
Controller -> DB: Query analysis_job + packets
activate DB
DB --> Controller: Return data
deactivate DB
Controller --> Web: Return data
deactivate Controller
Web --> User: Render results
deactivate Web
deactivate User

@enduml
